@attribute [Authorize]
@page "/members"
@inject GroupApiClient Groups
@inject MemberApiClient MemberApi
@inject AuthenticationStateProvider AuthenticationState

<PageTitle>Members</PageTitle>

<div class="members-page">
    <div class="page-heading">
        <div>
            <h1>Members</h1>
            <p class="page-description">Manage the members of the configured group and their nominees.</p>
        </div>
        @if (_canManage && _groupId.HasValue && !_showForm)
        {
            <button class="primary-button" @onclick="StartCreateAsync">Add Member</button>
        }
    </div>

    @if (_loading)
    {
        <section class="setup-card"><p>Loading members...</p></section>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert error">@_error</div>
    }
    else if (!_groupId.HasValue)
    {
        <div class="alert warning">Configure the single group before adding members.</div>
    }
    else
    {
        @if (_showForm)
        {
            <section class="setup-card">
                <div class="section-heading">
                    <div><h2>@(_editingMemberId.HasValue ? "Edit Member" : "Add Member")</h2><span class="muted">Group: @_groupName</span></div>
                    <button class="secondary-button" @onclick="CancelForm">Cancel</button>
                </div>
                <EditForm Model="_form" OnValidSubmit="SaveMemberAsync">
                    <div class="form-grid">
                        <div class="form-field">
                            <label>Member Code</label>
                            @if (_editingMemberId.HasValue)
                            {
                                <input class="text-input readonly-field" value="@_form.MemberNumber" readonly />
                            }
                            else
                            {
                                <input class="text-input readonly-field" value="@_form.MemberNumber" readonly />
                                <span class="date-hint">Automatically generated by the system. The next available code is assigned when the member is saved.</span>
                            }
                        </div>
                        <div class="form-field"><label>Full Name</label><InputText @bind-Value="_form.FullName" disabled="@(!_canManage)" /></div>
                        <div class="form-field"><label>Mobile</label><InputText @bind-Value="_form.MobileNumber" /></div>
                        <div class="form-field"><label>Email</label><InputText @bind-Value="_form.Email" /></div>
                        <div class="form-field"><label>Date of Birth</label><NepaliNullableDateInput @bind-Value="_form.DateOfBirth" /></div>
                        <div class="form-field"><label>Joining Date</label><NepaliDateInput @bind-Value="_form.JoinDate" /></div>
                        <div class="form-field"><label>Citizenship / Identification Reference</label><InputText @bind-Value="_form.CitizenshipNumber" /></div>
                        <div class="form-field"><label>Contribution Amount Override</label><InputNumber @bind-Value="_form.ContributionAmountOverride" /></div>
                        <div class="form-field full"><label>Address</label><InputTextArea @bind-Value="_form.Address" /></div>
                        <div class="form-field full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" /></div>
                        @if (_editingMemberId.HasValue)
                        {
                            <div class="form-field"><label>Exit Date</label><NepaliNullableDateInput @bind-Value="_form.ExitDate" /></div>
                            <div class="form-field checkbox-field"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div>
                        }
                    </div>
                    <button class="primary-button" type="submit" disabled="@_saving">@(_saving ? "Saving..." : "Save Member")</button>
                </EditForm>
            </section>
        }

        @if (!_showForm)
        {
            <section class="setup-card">
                <div class="section-heading">
                    <div><h2>Member List</h2><span class="muted">@(_members.Count) member(s) shown</span></div>
                    <label class="inline-check"><InputCheckbox @bind-Value="_includeInactive" @bind-Value:after="ReloadMembersAsync" /> Show inactive</label>
                </div>
                @if (_members.Count == 0)
                {
                    <p class="muted">No members have been added yet.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead><tr><th>Code</th><th>Full Name</th><th>Mobile</th><th>Email</th><th>Joining Date</th><th>Status</th><th>Nominees</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var member in _members)
                            {
                                <tr>
                                    <td>@member.MemberNumber</td>
                                    <td>@member.FullName</td>
                                    <td>@member.MobileNumber</td>
                                    <td>@member.Email</td>
                                    <td>@member.JoinDate.ToNepaliDateString()</td>
                                    <td><span class="badge @(member.IsActive ? "active" : "inactive")">@(member.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@member.Nominees.Count</td>
                                    <td><button class="link-button" @onclick="() => EditMember(member)">View / Edit</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (_editingMemberId.HasValue && _showNominees)
        {
            <section class="setup-card">
                <div class="section-heading"><div><h2>Nominees</h2><span class="muted">@_selectedMemberName</span></div></div>
                @if (_nomineeError is not null) { <div class="alert error">@_nomineeError</div> }
                <div class="nominee-grid">
                    @foreach (var nominee in _nominees)
                    {
                        <div class="nominee-card">
                            <strong>@nominee.FullName</strong>
                            <span>@nominee.Relationship</span>
                            <span>@(nominee.SharePercentage?.ToString("0.####") ?? "")%</span>
                            <span class="badge @(nominee.IsActive ? "active" : "inactive")">@(nominee.IsActive ? "Active" : "Inactive")</span>
                            @if (_canManage) { <button class="link-button" @onclick="() => BeginEditNominee(nominee)">Edit</button><button class="danger-button" @onclick="() => DeleteNomineeAsync(nominee.Id)">Remove</button> }
                        </div>
                    }
                </div>
                @if (_canManage)
                {
                    <div class="nominee-form">
                        <h3>@(_editingNomineeId.HasValue ? "Edit Nominee" : "Add Nominee")</h3>
                        <div class="form-grid">
                            <div class="form-field"><label>Full Name</label><InputText @bind-Value="_nomineeForm.FullName" /></div>
                            <div class="form-field"><label>Relationship</label><InputText @bind-Value="_nomineeForm.Relationship" /></div>
                            <div class="form-field"><label>Mobile</label><InputText @bind-Value="_nomineeForm.MobileNumber" /></div>
                            <div class="form-field"><label>Share Percentage</label><InputNumber @bind-Value="_nomineeForm.SharePercentage" /></div>
                            <div class="form-field full"><label>Address</label><InputTextArea @bind-Value="_nomineeForm.Address" /></div>
                            @if (_editingNomineeId.HasValue) { <div class="form-field checkbox-field"><label><InputCheckbox @bind-Value="_nomineeForm.IsActive" /> Active</label></div> }
                        </div>
                        <button class="primary-button" @onclick="SaveNomineeAsync" disabled="@_savingNominee">@(_savingNominee ? "Saving..." : (_editingNomineeId.HasValue ? "Save Nominee" : "Add Nominee"))</button>
                        @if (_editingNomineeId.HasValue) { <button class="secondary-button" @onclick="ResetNomineeForm">Cancel</button> }
                    </div>
                }
            </section>
        }
    }
</div>

@if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert success">@_message</div> }

@code {
    private long? _groupId;
    private string? _groupName;
    private List<MemberModel> _members = [];
    private List<MemberNomineeModel> _nominees = [];
    private MemberForm _form = new();
    private NomineeForm _nomineeForm = new();
    private long? _editingMemberId;
    private long? _editingNomineeId;
    private bool _showForm;
    private bool _showNominees;
    private bool _includeInactive;
    private bool _loading = true;
    private bool _saving;
    private bool _savingNominee;
    private bool _canManage;
    private string? _error;
    private string? _message;
    private string? _nomineeError;
    private string? _selectedMemberName;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        _canManage = state.User.HasClaim("permission", "Members.Manage");
        await LoadGroupAndMembersAsync();
    }

    private async Task LoadGroupAndMembersAsync()
    {
        _loading = true; _error = null;
        var groups = await Groups.GetGroupsAsync();
        if (!groups.Success) _error = groups.Error;
        else
        {
            var group = groups.Groups?.SingleOrDefault();
            _groupId = group?.Id;
            _groupName = group?.Name;
            if (_groupId.HasValue) await ReloadMembersAsync();
        }
        _loading = false;
    }

    private async Task ReloadMembersAsync()
    {
        if (!_groupId.HasValue) return;
        var result = await MemberApi.GetMembersAsync(_groupId.Value, _includeInactive);
        if (!result.Success) _error = result.Error;
        else _members = result.Members?.ToList() ?? [];
    }

    private async Task StartCreateAsync()
    {
        _editingMemberId = null; _showForm = true; _showNominees = false; _error = null; _message = null;
        _form = new MemberForm { JoinDate = DateTime.Today, MemberNumber = "Generating..." };

        if (_groupId.HasValue)
        {
            var next = await MemberApi.GetNextMemberNumberAsync(_groupId.Value);
            if (next.Success && !string.IsNullOrWhiteSpace(next.MemberNumber))
                _form.MemberNumber = next.MemberNumber;
            else
            {
                _form.MemberNumber = string.Empty;
                _error = next.Error ?? "Unable to determine the next member code.";
            }
        }
    }

    private void EditMember(MemberModel member)
    {
        _editingMemberId = member.Id; _showForm = true; _showNominees = true; _selectedMemberName = member.FullName; _error = null; _message = null;
        _form = new MemberForm(member);
        _nominees = member.Nominees.ToList();
        ResetNomineeForm();
    }

    private void CancelForm() { _showForm = false; _showNominees = false; _editingMemberId = null; _editingNomineeId = null; }

    private async Task SaveMemberAsync()
    {
        if (!_groupId.HasValue) return;
        _saving = true; _error = null; _message = null;
        if (_editingMemberId.HasValue)
        {
            var result = await MemberApi.UpdateAsync(_editingMemberId.Value, new UpdateMemberModel(_form.MemberNumber, _form.FullName, _form.Address, _form.MobileNumber, _form.Email, _form.DateOfBirth, _form.JoinDate, _form.ExitDate, _form.IsActive, _form.CitizenshipNumber, _form.ContributionAmountOverride, _form.Notes));
            if (!result.Success) _error = result.Error;
            else { _message = "Member information saved."; _showForm = false; await ReloadMembersAsync(); }
        }
        else
        {
            var result = await MemberApi.CreateAsync(new CreateMemberModel(_groupId.Value, _form.MemberNumber, _form.FullName, _form.Address, _form.MobileNumber, _form.Email, _form.DateOfBirth, _form.JoinDate, _form.CitizenshipNumber, _form.ContributionAmountOverride, _form.Notes, null));
            if (!result.Success) _error = result.Error;
            else { _message = "Member created successfully."; _showForm = false; await ReloadMembersAsync(); }
        }
        _saving = false;
    }

    private void BeginEditNominee(MemberNomineeModel nominee)
    {
        _editingNomineeId = nominee.Id;
        _nomineeForm = new NomineeForm(nominee);
        _nomineeError = null;
    }

    private void ResetNomineeForm() { _editingNomineeId = null; _nomineeForm = new NomineeForm(); _nomineeError = null; }

    private async Task SaveNomineeAsync()
    {
        if (!_editingMemberId.HasValue) return;
        _savingNominee = true; _nomineeError = null;
        if (_editingNomineeId.HasValue)
        {
            var result = await MemberApi.UpdateNomineeAsync(_editingMemberId.Value, _editingNomineeId.Value, new UpdateMemberNomineeModel(_nomineeForm.FullName, _nomineeForm.Relationship, _nomineeForm.MobileNumber, _nomineeForm.Address, _nomineeForm.SharePercentage, _nomineeForm.IsActive));
            if (!result.Success) _nomineeError = result.Error;
        }
        else
        {
            var result = await MemberApi.AddNomineeAsync(_editingMemberId.Value, new CreateMemberNomineeModel(_nomineeForm.FullName, _nomineeForm.Relationship, _nomineeForm.MobileNumber, _nomineeForm.Address, _nomineeForm.SharePercentage));
            if (!result.Success) _nomineeError = result.Error;
        }
        if (_nomineeError is null)
        {
            var nominees = await MemberApi.GetNomineesAsync(_editingMemberId.Value);
            if (nominees.Success) _nominees = nominees.Nominees?.ToList() ?? [];
            ResetNomineeForm();
        }
        _savingNominee = false;
    }

    private async Task DeleteNomineeAsync(long nomineeId)
    {
        if (!_editingMemberId.HasValue) return;
        _nomineeError = null;
        var result = await MemberApi.RemoveNomineeAsync(_editingMemberId.Value, nomineeId);
        if (!result.Success) _nomineeError = result.Error;
        else
        {
            var nominees = await MemberApi.GetNomineesAsync(_editingMemberId.Value);
            if (nominees.Success) _nominees = nominees.Nominees?.ToList() ?? [];
        }
    }

    private sealed class MemberForm
    {
        public string MemberNumber { get; set; } = "MEM-001";
        public string FullName { get; set; } = string.Empty;
        public string? Address { get; set; }
        public string? MobileNumber { get; set; }
        public string? Email { get; set; }
        public DateTime? DateOfBirth { get; set; }
        public DateTime JoinDate { get; set; } = DateTime.Today;
        public DateTime? ExitDate { get; set; }
        public bool IsActive { get; set; } = true;
        public string? CitizenshipNumber { get; set; }
        public decimal? ContributionAmountOverride { get; set; }
        public string? Notes { get; set; }
        public MemberForm() { }
        public MemberForm(MemberModel x) { MemberNumber=x.MemberNumber; FullName=x.FullName; Address=x.Address; MobileNumber=x.MobileNumber; Email=x.Email; DateOfBirth=x.DateOfBirth; JoinDate=x.JoinDate; ExitDate=x.ExitDate; IsActive=x.IsActive; CitizenshipNumber=x.CitizenshipNumber; ContributionAmountOverride=x.ContributionAmountOverride; Notes=x.Notes; }
    }

    private sealed class NomineeForm
    {
        public string FullName { get; set; } = string.Empty;
        public string? Relationship { get; set; }
        public string? MobileNumber { get; set; }
        public string? Address { get; set; }
        public decimal? SharePercentage { get; set; }
        public bool IsActive { get; set; } = true;
        public NomineeForm() { }
        public NomineeForm(MemberNomineeModel x) { FullName=x.FullName; Relationship=x.Relationship; MobileNumber=x.MobileNumber; Address=x.Address; SharePercentage=x.SharePercentage; IsActive=x.IsActive; }
    }
}
