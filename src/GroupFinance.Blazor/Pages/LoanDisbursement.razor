@attribute [Authorize]
@page "/loan-disbursement"
@inject GroupApiClient GroupApi
@inject LoanApplicationApiClient LoanApplicationApi
@inject GroupFundApiClient FundApi
@inject LoanDisbursementApiClient DisbursementApi

<PageTitle>Loan Disbursement</PageTitle>

<div class="page-shell">
    <div class="page-heading">
        <div><h1>Loan Disbursement</h1><p class="muted">Disburse approved loan applications into the member loan receivable account and selected group fund account.</p></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert error">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert success">@_message</div> }

    @if (_loading) { <p>Loading...</p> }
    else if (_group is null) { <section class="setup-card"><p>No active group is configured.</p></section> }
    else
    {
        <section class="card">
            <div class="section-heading"><div><h2>Approved Applications Ready for Disbursement</h2><p class="muted">Only Approved applications without an existing loan are shown.</p></div><button class="secondary-button" @onclick="LoadAsync">Refresh</button></div>
            @if (_approvedApplications.Count == 0) { <p class="muted">No approved loan applications are currently ready for disbursement.</p> }
            else
            {
                <div class="table-wrapper"><table class="data-table"><thead><tr><th>Application</th><th>Member</th><th>Amount</th><th>Method</th><th>Rate</th><th>Duration</th><th>EMI</th><th>Guarantors</th><th></th></tr></thead><tbody>
                @foreach (var application in _approvedApplications)
                {
                    <tr><td>@application.LoanApplicationNumber</td><td>@application.MemberNumber - @application.MemberName</td><td>NPR @application.RequestedAmount.ToString("N2")</td><td>@application.ProposedInterestMethod</td><td>@application.ProposedInterestRate.ToString("0.####")%</td><td>@application.RequestedDurationMonths months</td><td>NPR @application.RequestedEmi.ToString("N2")</td><td>@application.GuarantorCount</td><td><button class="primary-button" @onclick="() => SelectApplicationAsync(application.Id)">Disburse</button></td></tr>
                }
                </tbody></table></div>
            }
        </section>

        @if (_selected is not null)
        {
            <section class="setup-card">
                <div class="section-heading"><div><h2>Disburse @_selected.LoanApplicationNumber</h2><p class="muted">Member: @_selected.MemberNumber - @_selected.MemberName | Principal: NPR @_selected.RequestedAmount.ToString("N2")</p></div><button class="secondary-button" @onclick="ClearSelection">Cancel</button></div>
                <div class="form-grid">
                    <div class="form-field"><label>Disbursement Account</label><InputSelect @bind-Value="_form.FinancialAccountId"><option value="0">Select Cash / Bank account</option>@foreach (var account in _accounts.Where(x => x.IsActive && IsFundAccount(x.AccountType))) { <option value="@account.Id">@account.AccountCode - @account.AccountName (NPR @account.Balance.ToString("N2"))</option> }</InputSelect></div>
                    <div class="form-field"><label>Disbursement Date</label><NepaliDateInput @bind-Value="_form.DisbursementDate" /></div>
                    <div class="form-field"><label>Reference Number</label><InputText @bind-Value="_form.ReferenceNumber" /></div>
                    <div class="form-field"><label>Description</label><InputText @bind-Value="_form.Description" /></div>
                </div>
                <div class="alert"><strong>Accounting:</strong> Debit Member Loan Receivable and Credit the selected fund account for NPR @_selected.RequestedAmount.ToString("N2").</div>
                <button class="primary-button" disabled="@_saving" @onclick="DisburseAsync">@(_saving ? "Disbursing..." : "Confirm Disbursement")</button>
            </section>
        }

        <section class="card">
            <div class="section-heading"><div><h2>Disbursed Loans</h2></div></div>
            @if (_loans.Count == 0) { <p class="muted">No loans have been disbursed yet.</p> }
            else
            {
                <div class="table-wrapper"><table class="data-table"><thead><tr><th>Loan No.</th><th>Member</th><th>Disbursed</th><th>Principal</th><th>EMI</th><th>Interest</th><th>Outstanding Principal</th><th>Status</th><th></th></tr></thead><tbody>
                @foreach (var loan in _loans)
                { <tr><td>@loan.LoanNumber</td><td>@loan.MemberNumber - @loan.MemberName</td><td>@loan.DisbursementDate.ToNepaliDateString()</td><td>NPR @loan.PrincipalAmount.ToString("N2")</td><td>NPR @loan.InstallmentAmount.ToString("N2")</td><td>NPR @loan.TotalInterest.ToString("N2")</td><td>NPR @loan.OutstandingPrincipal.ToString("N2")</td><td><span class="badge">@loan.Status</span></td><td><button class="link-button" @onclick="() => LoadScheduleAsync(loan.Id)">Schedule</button></td></tr> }
                </tbody></table></div>
            }
        </section>

        @if (_schedule is not null)
        {
            <section class="card"><div class="section-heading"><div><h2>Loan Schedule</h2><p class="muted">Loan ID: @_selectedLoanId</p></div><button class="secondary-button" @onclick="() => _schedule = null">Close</button></div>
                <div class="table-wrapper"><table class="data-table"><thead><tr><th>#</th><th>Due Date</th><th>Opening Principal</th><th>Principal</th><th>Interest</th><th>Total Due</th><th>Outstanding</th><th>Status</th></tr></thead><tbody>
                @foreach (var line in _schedule) { <tr><td>@line.InstallmentNumber</td><td>@line.DueDate.ToNepaliDateString()</td><td>NPR @line.OpeningPrincipal.ToString("N2")</td><td>NPR @line.PrincipalDue.ToString("N2")</td><td>NPR @line.InterestDue.ToString("N2")</td><td>NPR @line.TotalDue.ToString("N2")</td><td>NPR @line.OutstandingAmount.ToString("N2")</td><td>@line.Status</td></tr> }
                </tbody></table></div>
            </section>
        }
    }
</div>

@code {
    private GroupModel? _group;
    private List<LoanApplicationSummaryModel> _approvedApplications = [];
    private List<GroupFundAccountModel> _accounts = [];
    private List<LoanSummaryModel> _loans = [];
    private LoanApplicationModel? _selected;
    private LoanDisbursementRequestModel _form = new() { DisbursementDate = DateTime.Today };
    private List<LoanScheduleModel>? _schedule;
    private long _selectedLoanId;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        var groups = await GroupApi.GetGroupsAsync();
        if (!groups.Success || groups.Groups is null || groups.Groups.Count == 0) { _error = groups.Error ?? "No active group is configured."; _loading = false; return; }
        _group = groups.Groups[0];
        var applications = await LoanApplicationApi.GetApplicationsAsync(_group.Id, "Approved");
        if (!applications.Success) { _error = applications.Error; _loading = false; return; }
        var loans = await DisbursementApi.GetLoansAsync(_group.Id);
        if (!loans.Success) { _error = loans.Error; _loading = false; return; }
        _loans = loans.Data?.ToList() ?? [];
        var existingLoanApplicationIds = _loans.Select(x => x.LoanApplicationId).ToHashSet();
        _approvedApplications = applications.Applications?.Where(x => !existingLoanApplicationIds.Contains(x.Id)).ToList() ?? [];
        var accounts = await FundApi.GetAccountsAsync(_group.Id);
        if (!accounts.Success) { _error = accounts.Error; _loading = false; return; }
        _accounts = accounts.Data?.ToList() ?? [];
        _loading = false;
    }

    private async Task SelectApplicationAsync(long id)
    {
        _error = _message = null;
        var result = await LoanApplicationApi.GetAsync(id);
        if (!result.Success || result.Data is null) { _error = result.Error ?? "Unable to load loan application."; return; }
        _selected = result.Data;
        _form = new LoanDisbursementRequestModel { DisbursementDate = DateTime.Today, Description = $"Loan disbursement {_selected.LoanApplicationNumber}" };
    }

    private void ClearSelection() { _selected = null; _error = null; }

    private async Task DisburseAsync()
    {
        if (_selected is null) return;
        _saving = true; _error = _message = null;
        var result = await DisbursementApi.DisburseAsync(_selected.Id, _form);
        _saving = false;
        if (!result.Success || result.Data is null) { _error = result.Error; return; }
        _message = $"Loan {result.Data.LoanNumber} disbursed successfully. Financial transaction {result.Data.FinancialTransactionNumber} posted.";
        _selected = null;
        await LoadAsync();
    }

    private async Task LoadScheduleAsync(long loanId)
    {
        _error = null;
        var result = await DisbursementApi.GetScheduleAsync(loanId);
        if (!result.Success) { _error = result.Error; return; }
        _selectedLoanId = loanId; _schedule = result.Data?.ToList() ?? [];
    }

    private static bool IsFundAccount(string type) => type.Equals("Cash", StringComparison.OrdinalIgnoreCase) || type.Equals("Bank", StringComparison.OrdinalIgnoreCase) || type.Equals("Other", StringComparison.OrdinalIgnoreCase);
}
