{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "GroupFinance",
    "Audience": "GroupFinance.Client",
    "SecretKey": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "AccessTokenMinutes": 30
  },
  "BootstrapAdmin": {
    "Username": "",
    "Password": "",
    "FullName": "System Administrator"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "FileStorage": {
    "RootPath": "App_Data/Attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".docx",
      ".xlsx"
    ]
  },
  "Database": {
    "AutoMigrate": false
  }
}
