{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_STAGING_CONNECTION_STRING"
  },
  "Jwt": {
    "Issuer": "GroupFinance-Staging",
    "Audience": "GroupFinance.Client",
    "SecretKey": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES",
    "AccessTokenMinutes": 30
  },
  "BootstrapAdmin": {
    "Username": "",
    "Password": "",
    "FullName": "System Administrator"
  },
  "Database": {
    "AutoMigrate": false
  },
  "AllowedHosts": "localhost",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "FileStorage": {
    "RootPath": "D:/GroupFinance/Staging/Data/Attachments",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".docx",
      ".xlsx"
    ]
  }
,
  "Backup": {
    "Enabled": true,
    "BackupDirectory": "D:/GroupFinance/Staging/Backups",
    "RetentionDays": 30,
    "TimeZoneId": "Nepal Standard Time",
    "RecoveryDatabaseName": "GroupFinance_Phase29_RestoreTest",
    "RecoveryDataDirectory": "D:/GroupFinance/Staging/Recovery",
    "RecoveryLogDirectory": "D:/GroupFinance/Staging/Recovery",
    "AllowRestoreDrill": true,
    "CommandTimeoutSeconds": 600,
    "SchedulerEnabled": true
  }
}
